  lines:
  - speaker: Old Spin
    portrait: {fileID: -7527145504033472756, guid: cc123686e6899b64f899e21fa51f72be, type: 3}
    text: The sea keeps its own tempo, kid.
  - speaker: Old Spin
    portrait: {fileID: -7527145504033472756, guid: cc123686e6899b64f899e21fa51f72be, type: 3}
    text: Find the record by the dock, and we'll see if you can keep up.
  - speaker: Old Spin
    portrait: {fileID: -7527145504033472756, guid: cc123686e6899b64f899e21fa51f72be, type: 3}
    text: Come back when you're ready.
  interactionRadius: 1.5
