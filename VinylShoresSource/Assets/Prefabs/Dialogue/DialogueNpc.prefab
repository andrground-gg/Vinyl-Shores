--- !u!114 &3060457645998674051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8083745012208720445}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2573b3ead02b484ca81f3549b5cbb9f9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VinylShores.Dialogue.DialogueInteractable
  lines:
  - speaker: Old Spin
    portrait: {fileID: -7527145504033472756, guid: cc123686e6899b64f899e21fa51f72be, type: 3}
    text: The sea keeps its own tempo, kid.
  - speaker: Old Spin
    portrait: {fileID: -7527145504033472756, guid: cc123686e6899b64f899e21fa51f72be, type: 3}
    text: Find the record by the dock, and we'll see if you can keep up.
  - speaker: Old Spin
    portrait: {fileID: -7527145504033472756, guid: cc123686e6899b64f899e21fa51f72be, type: 3}
    text: Come back when you're ready.
  interactionRadius: 1.5
  player: {fileID: 0}
  ui: {fileID: 0}
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
